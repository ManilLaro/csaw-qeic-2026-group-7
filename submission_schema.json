{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "stage": {
      "type": "object",
      "required": [
        "verdict",
        "confidence"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "VALID_EXECUTION",
            "INTEGRITY_VIOLATION",
            "INSUFFICIENT_EVIDENCE"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "layer_assessments": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "estimated_parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "suspected_fault_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "root_cause": {
          "type": [
            "string",
            "null"
          ]
        },
        "proposed_repair": {
          "type": [
            "string",
            "null"
          ]
        },
        "repair_validation": {
          "type": [
            "string",
            "null"
          ]
        },
        "affected_logical_operations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_physical_resources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suspected_realized_resources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "incidental_anomalies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifact_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "artifact",
              "claim"
            ],
            "properties": {
              "artifact": {
                "type": "string",
                "minLength": 1
              },
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "runtime_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "artifact",
              "claim"
            ],
            "properties": {
              "artifact": {
                "type": "string",
                "minLength": 1
              },
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "device_design_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "artifact",
              "claim"
            ],
            "properties": {
              "artifact": {
                "type": "string",
                "minLength": 1
              },
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "device_model_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "artifact",
              "claim"
            ],
            "properties": {
              "artifact": {
                "type": "string",
                "minLength": 1
              },
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "control_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "artifact",
              "claim"
            ],
            "properties": {
              "artifact": {
                "type": "string",
                "minLength": 1
              },
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "simulation_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "artifact",
              "claim"
            ],
            "properties": {
              "artifact": {
                "type": "string",
                "minLength": 1
              },
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "diagnostic_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "job_id",
              "shots",
              "qubits",
              "depth",
              "claim"
            ],
            "properties": {
              "job_id": {
                "type": "string",
                "minLength": 1
              },
              "shots": {
                "type": "integer",
                "minimum": 1
              },
              "qubits": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 31
                }
              },
              "depth": {
                "type": "integer",
                "minimum": 0,
                "maximum": 50
              },
              "claim": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "challenge_release_id",
    "participant_solution_sha256",
    "public_artifact_sha256",
    "stage_submissions",
    "runtime_seconds",
    "environment"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "challenge_release_id": {
      "const": "qei-2026-11-12"
    },
    "participant_solution_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "public_artifact_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "stage_submissions": {
      "type": "object",
      "required": [
        "stage_1",
        "stage_2"
      ],
      "properties": {
        "stage_1": {
          "$ref": "#/$defs/stage"
        },
        "stage_2": {
          "$ref": "#/$defs/stage"
        }
      },
      "additionalProperties": false
    },
    "runtime_seconds": {
      "type": "number",
      "minimum": 0
    },
    "environment": {
      "type": "object",
      "required": [
        "python",
        "platform",
        "packages"
      ],
      "properties": {
        "python": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "packages": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
